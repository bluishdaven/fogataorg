{
  "name": "fogata",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:generate": "drizzle-kit generate",
    "db:migration": "drizzle-kit generate --custom",
    "db:reset": "supabase db reset",
    "db:seed": "tsx --env-file=.env.local scripts/seed/index.ts",
    "setup:env": "tsx scripts/write-local-env.ts",
    "setup": "npm run db:start && npm run setup:env && npm run db:reset && npm run db:seed"
  },
  "dependencies": {
