# Copy to .env.local, or run `npm run setup:env` to fill it from the local Supabase stack.
# Never commit real values. Production values live in Vercel's project settings.

# Public URL of this deployment (used for metadata and as the auth redirect fallback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Show the "Continue with Google" button (requires Google configured in Supabase).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server only. Postgres connection used by Drizzle (queries run through withRls()).
# Production: Supabase transaction pooler, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server/scripts only. Secret (service role) key, used by the seed script. Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server only. Unsplash access key for writers' photo search (https://unsplash.com/oauth/applications).
# Leave empty to disable photo search; the picker then says it isn't set up.
UNSPLASH_ACCESS_KEY=
# Set to true once Unsplash has enabled the `lang` beta for this app, so Spanish searches work well.
UNSPLASH_LANG_BETA=false

# Local email inbox (Mailpit) used by e2e tests.
MAILPIT_URL=http://127.0.0.1:54324

# Local only: Google OAuth credentials for supabase/config.toml.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
