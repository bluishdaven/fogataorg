    "@tiptap/starter-kit": "3.32.2",
    "@tiptap/suggestion": "3.32.2",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.68.0",
