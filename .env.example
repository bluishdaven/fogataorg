# Copy to .env.local, or run `npm run setup:env` to fill it from the local Supabase stack.
# Never commit real values. Production values live in Vercel's project settings.

# Public URL of this deployment (used for metadata and as the auth redirect fallback).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL and publishable (anon) key. Safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Show the "Continue with Google" button (requires Google configured in Supabase).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# Server only. Postgres connection used by Drizzle (queries run through withRls()).
# Production: Supabase transaction pooler, e.g.
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Server/scripts only. Secret (service role) key: the seed script, and the daily cron's cleanup of
# unused uploads (skipped when unset). Never expose it.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Server only. Unsplash access key for writers' photo search (https://unsplash.com/oauth/applications).
# Leave empty to disable photo search; the picker then says it isn't set up.
UNSPLASH_ACCESS_KEY=
# Set to true once Unsplash has enabled the `lang` beta for this app, so Spanish searches work well.
UNSPLASH_LANG_BETA=false

# Cloudflare Turnstile ("are you a person?") on the sign-in form. Leave both empty locally and in
# tests: no widget, no check. Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Local email inbox (Mailpit). Without RESEND_API_KEY, summary emails are delivered here; e2e reads it.
MAILPIT_URL=http://127.0.0.1:54324

# Server only. Email through Resend (https://resend.com) in production. Leave empty locally.
RESEND_API_KEY=
# Sender address, on a domain verified in Resend.
EMAIL_FROM=Fogata <hola@fogata.org>
# Server only. Signs one-click unsubscribe links. Long random value; `npm run setup:env` makes one locally.
# Changing it breaks the unsubscribe links in emails already sent.
EMAIL_SIGNING_SECRET=
# Server only. Bearer token Vercel Cron sends to /api/cron/notification-emails. Generated locally too.
CRON_SECRET=
# Most weekly summaries sent per daily run (default 80, under Resend's free 100/day with sign-ins).
EMAIL_SUMMARY_DAILY_LIMIT=80

# Local only: Google OAuth credentials for supabase/config.toml.
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
